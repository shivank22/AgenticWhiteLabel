# LLM
DICE_LLM_PROVIDER=openai
DICE_LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# Persistence (optional — MemorySaver used when unset)
DICE_DATABASE_URL=postgresql+asyncpg://dice:dice@localhost:5432/dice
DICE_APP_DATABASE_URL=

# Skills
DICE_SKILLS_BASE_PATH=skills

# Authenticated API / PACE discovery
DICE_API_BEARER_TOKEN=
DICE_PACE_SERVERS_URL=
DICE_PACE_TOKEN_URL=
DICE_PACE_CLIENT_ID=
DICE_PACE_CLIENT_SECRET=
DICE_PACE_SCOPE=

# Workflow chat UI
DICE_WEB_HOST=127.0.0.1
DICE_WEB_PORT=8080
